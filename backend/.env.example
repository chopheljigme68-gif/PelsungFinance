

# NODE_ENV=development
# PORT=4000

# # Supabase Postgres connection string.
# # Supabase dashboard -> Project Settings -> Database -> Connection string -> URI.
# # Use the "Session pooler" (port 5432) or "Transaction pooler" (port 6543) URI.
# # The password must be URL-encoded if it contains special characters.
# DATABASE_URL=postgresql://postgres.idlyctrrzmdhubhbgvdu:BcOZXxLHxcIOhwUx@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
# # Postgres pool sizing and TLS. Supabase requires TLS.
# DATABASE_SSL=true
# DATABASE_POOL_MAX=10

# # Comma-separated list of browser origins allowed to call this API with cookies.
# CORS_ORIGINS=http://localhost:3000

# # Public URL of the Next.js frontend — used in invitation emails.
# APP_URL=http://localhost:3000

# # Session cookie. Set COOKIE_SECURE=true whenever the app is served over HTTPS.
# # COOKIE_DOMAIN is only needed when the API and the frontend share a parent domain.
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=
# SESSION_TTL_HOURS=8

# # ---------------------------------------------------------------------------
# # Bootstrap administrator — created by `npm run db:seed` when no users exist.
# # The password must be 8-20 characters with an uppercase letter and a symbol.
# # ---------------------------------------------------------------------------
# BOOTSTRAP_ADMIN_EMAIL=agency.admin@pelsung.bt
# BOOTSTRAP_ADMIN_PASSWORD=Pelsung@2026
# BOOTSTRAP_ADMIN_NAME=Pelsung Admin
# BOOTSTRAP_ADMIN_DESIGNATION=Head of Finance
# BOOTSTRAP_ADMIN_CID=

# # Seed the 51 approved FY 2026-2027 budget activities on first setup.
# SEED_BUDGET_ACTIVITIES=true

# # ---------------------------------------------------------------------------
# # Email delivery (Resend) — user invitations and payslips.
# # Leave blank to disable email; the app stays usable and reports "invitation
# # pending" instead of failing.
# # ---------------------------------------------------------------------------
# RESEND_API_KEY=re_DjHbn9of_PpQCFbFEjp331AeDtJXavg9D
# RESEND_FROM_EMAIL=onboarding@resend.dev





# ---------------------------------------------------------------------------
# Pelsung Finance — backend environment
# Copy to .env and fill in. Never commit the completed file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Supabase Postgres connection string.
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI.
# Use the "Session pooler" (port 5432) or "Transaction pooler" (port 6543) URI.
# The password must be URL-encoded if it contains special characters.
DATABASE_URL=postgresql://postgres.idlyctrrzmdhubhbgvdu:BcOZXxLHxcIOhwUx@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
# Postgres pool sizing and TLS. Supabase requires TLS.
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# Comma-separated list of browser origins allowed to call this API with cookies.
CORS_ORIGINS=http://localhost:3000

# Public URL of the Next.js frontend — used in invitation emails.
APP_URL=http://localhost:3000

# Session cookie. Set COOKIE_SECURE=true whenever the app is served over HTTPS.
# COOKIE_DOMAIN is only needed when the API and the frontend share a parent domain.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
SESSION_TTL_HOURS=8

# ---------------------------------------------------------------------------
# Bootstrap administrator — created by `npm run db:seed` when no users exist.
# The password must be 8-20 characters with an uppercase letter and a symbol.
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=agency.admin@pelsung.bt
BOOTSTRAP_ADMIN_PASSWORD=Pelsung@2026
BOOTSTRAP_ADMIN_NAME=Pelsung Admin
BOOTSTRAP_ADMIN_DESIGNATION=Head of Finance
BOOTSTRAP_ADMIN_CID=

# Seed the 51 approved FY 2026-2027 budget activities on first setup.
SEED_BUDGET_ACTIVITIES=true

# ---------------------------------------------------------------------------
# Email delivery — invitations (user ID + temporary password) and payslips.
#
# Fill in ONE of the two blocks below. SMTP wins if both are set. Leave both
# blank to run without email: the app stays usable and reports "invitation
# pending" instead of failing.
#
# Verify whatever you configure before relying on it:
#     npm run test-email -- you@example.com
# ---------------------------------------------------------------------------

# --- Option A: SMTP — any mailbox provider, delivers to anyone, no domain ---
# Gmail: turn on 2-Step Verification, create an App Password
# (myaccount.google.com/apppasswords) and use those 16 characters below —
# your normal Gmail password will be rejected.
#   host smtp.gmail.com   port 587   user <you>@gmail.com
# Outlook / Microsoft 365: smtp.office365.com, port 587.
# Port 465 instead of 587 also works; set SMTP_SECURE=true for it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
# Shown as the sender. Defaults to SMTP_USER. Most providers only allow an
# address the account owns.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Pelsung Finance
# Only for an internal relay with a self-signed certificate.
SMTP_ALLOW_SELF_SIGNED=false

# --- Option B: Resend — HTTP API, needs a verified domain for real use ------
# Without a verified domain, the shared sender onboarding@resend.dev reaches
# ONLY the address that owns the Resend account. Verify your domain and use a
# sender on it to email anyone else.
RESEND_API_KEY=re_DjHbn9of_PpQCFbFEjp331AeDtJXavg9D
RESEND_FROM_EMAIL=onboarding@resend.dev
